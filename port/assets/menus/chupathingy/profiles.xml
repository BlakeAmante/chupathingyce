	</widget>
	<widget name="chupathingy/profiles/list_item_4" controller="1" width="256" height="32" bitmap="bitmaps/list_item_bkd">
		<on event="a" run="single prev cl item activated"/>
		<on event="start" run="single prev cl item activated"/>
		<on event="left_mouse" run="mouse emit accept event"/>
		<child widget="chupathingy/profiles/list_item_text"/>
	</widget>
	<widget name="chupathingy/profiles/list_item_5" controller="1" width="256" height="32" bitmap="bitmaps/list_item_bkd">
		<on event="a" run="single prev cl item activated"/>
		<on event="start" run="single prev cl item activated"/>
		<on event="left_mouse" run="mouse emit accept event"/>
		<child widget="chupathingy/profiles/list_item_text"/>
	</widget>
	<widget name="chupathingy/profiles/list_item_6" controller="1" width="256" height="32" bitmap="bitmaps/list_item_bkd">
		<on event="a" run="single prev cl item activated"/>
		<on event="start" run="single prev cl item activated"/>
		<on event="left_mouse" run="mouse emit accept event"/>
		<child widget="chupathingy/profiles/list_item_text"/>
	</widget>
	<widget name="chupathingy/profiles/list_item_7" controller="1" width="256" height="32" bitmap="bitmaps/list_item_bkd">
		<on event="a" run="single prev cl item activated"/>
		<on event="start" run="single prev cl item activated"/>
		<on event="left_mouse" run="mouse emit accept event"/>
		<child widget="chupathingy/profiles/list_item_text"/>
	</widget>
	<widget name="chupathingy/profiles/list_item_8" controller="1" width="256" height="32" bitmap="bitmaps/list_item_bkd">
		<on event="a" run="single prev cl item activated"/>
		<on event="start" run="single prev cl item activated"/>
		<on event="left_mouse" run="mouse emit accept event"/>
		<child widget="chupathingy/profiles/list_item_text"/>
	</widget>
	<widget name="chupathingy/profiles/list_item_9" controller="1" width="256" height="32" bitmap="bitmaps/list_item_bkd">
		<on event="a" run="single prev cl item activated"/>
		<on event="start" run="single prev cl item activated"/>
		<on event="left_mouse" run="mouse emit accept event"/>
		<child widget="chupathingy/profiles/list_item_text"/>
	</widget>
	<widget name="chupathingy/profiles/list_item_10" controller="1" width="256" height="32" bitmap="bitmaps/list_item_bkd">
		<on event="a" run="single prev cl item activated"/>
		<on event="start" run="single prev cl item activated"/>
		<on event="left_mouse" run="mouse emit accept event"/>
		<child widget="chupathingy/profiles/list_item_text"/>
	</widget>
	<widget name="chupathingy/profiles/list_item_text" type="text" controller="1" width="256" height="32" font="ui\large_ui" color="#FF2896FF" text_flags="no_focus_test" text_x="13" text_y="5">
	</widget>
	<!-- (deleting one: the Xbox's question, its small B and A prompts) -->
	<widget name="chupathingy/profiles/confirm_delete" width="640" height="480" flags="pass_unhandled_to_focused_child" bitmap="ui\shell\bitmaps\semi_transparent_grey">
		<on event="a" run="final del player profile" close="current"/>
		<on event="start" run="final del player profile" close="current"/>
		<on event="b" run="cancel profile delete" close="current" sound="sound\sfx\ui\back"/>
		<on event="back" run="cancel profile delete" close="current" sound="sound\sfx\ui\back"/>
		<child widget="error/confirm_delete_profile_text_box" x="192" y="176"/>
		<child widget="error/header_warning" x="201" y="180"/>
		<child widget="chupathingy/dialog_prompts"/>
	</widget>
</menus>
